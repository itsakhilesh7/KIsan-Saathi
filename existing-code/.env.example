# ---- Gnani ----
GNANI_API_KEY=
STT_MODEL=prisma-v3.0
STT_LANGUAGE=indic-auto
TTS_MODEL=timbre-v2.5
# Only used when TTS_MODEL=timbre-v3.0 (every v3.0 voice speaks all 10 languages)
TTS_V3_VOICE=Shivani

# ---- LLM (OpenAI-compatible endpoint serving Evon, e.g. vLLM/SGLang). Leave blank = echo mode ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# ---- WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_me_to_any_random_string
META_APP_SECRET=
WA_API_VERSION=v23.0

# ---- Behaviour ----
SEND_TEXT_COPY=true
