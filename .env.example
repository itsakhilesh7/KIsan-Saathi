# Copy to backend/.env. Never commit real values.

# ---- App ----
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
PHONE_HASH_SALT=change_me
ALLOW_CHEMICAL_DETAILS=false
RATE_LIMIT_PER_MIN=20
SEND_TEXT_COPY=true
STORE_RAW_TRANSCRIPTS=false

# ---- Pilot (see config/pilot.example.yaml; copy to config/pilot.yaml) ----
PILOT_CONFIG_PATH=config/pilot.yaml

# ---- Gnani (endpoints/params verified in docs/gnani-api-notes.md) ----
GNANI_API_KEY=
STT_MODEL=prisma-v3.0
STT_LANGUAGE=indic-auto
TTS_MODEL=timbre-v2.5
TTS_V3_VOICE=Shivani
TTS_DEFAULT_LANG=hi-IN

# ---- LLM: any OpenAI-compatible endpoint. Evon preferred; a stand-in is fine for development ----
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# Recorded in every eval/demo result so we never misreport which model answered:
LLM_DISCLOSED_NAME=

# ---- WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_me_random_string
META_APP_SECRET=
WA_API_VERSION=v23.0

# ---- data.gov.in ----
DATA_GOV_API_KEY=
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
KCC_RESOURCE_IDS=

# ---- Open-Meteo ----
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---- Storage / retrieval ----
DATABASE_URL=
VECTOR_BACKEND=pgvector
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ---- Audio ----
AUDIO_MAX_SECONDS=60
AUDIO_MAX_MB=15
AUDIO_RETENTION_HOURS=24
